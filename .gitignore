# ROOT files, wherever they are
*.root

# Build products
libTools.so
macros/HSCPSelector_C*
__pycache__/
*.pyc

# output/ and outputDisplay/ are part of the repository, their content is not.
# Each directory to keep holds an empty .gitkeep file.
output/**
!output/**/
!output/**/.gitkeep
outputDisplay/**
!outputDisplay/**/
!outputDisplay/**/.gitkeep
# HTCondor working directories (chunks, generated selectors, logs, job outputs)
condor/work/

# smoke-test working directory
tests/work/
# pixi environments
.pixi/*
!.pixi/config.toml

# generated from macros/HSCPTemplate.{h,C} at every launch (python/hscp/selector.py)
macros/HSCPSelector.h
macros/HSCPSelector.C
